# EchoGuard AI Frontend Environment Variables
# In production on Vercel, set these in Project Settings -> Environment Variables

# Backend API HTTP endpoint (e.g. deployed on Render, Railway, Hugging Face, or Cloud Run)
VITE_API_BASE_URL=https://your-backend-api.onrender.com

# Backend WebSocket endpoint (wss:// for SSL/HTTPS)
VITE_WS_BASE_URL=wss://your-backend-api.onrender.com
